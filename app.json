{
  "expo": {
    "name": "Namaz Mentor",
    "slug": "namaz-mentor",
    "version": "1.0.0",
    "icon": "./assets/img/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#021226"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.susmoy.namazmentor",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to calculate accurate prayer times and Qibla direction.",
        "NSUserNotificationsUsageDescription": "Namaz Mentor uses notifications to remind you when each prayer begins."
      }
    },
    "web": {
      "favicon": "./assets/img/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/img/icon.png",
        "backgroundColor": "#021226"
      },
      "package": "com.susmoy.namazmentor",
      "permissions": [  
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/adhan.wav"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bb7c1fd6-9a0e-4998-a36b-78bf182be657"
      }
    },
    "owner": "chadni"
  }
}
